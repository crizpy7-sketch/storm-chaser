; Engine configuration file.
; It's best edited using the editor UI and not directly,
; since the parameters that go here are not all obvious.
;
; Format:
;   [section] ; section goes between []
;   param=value ; assign values to parameters

config_version=5

[application]

config/name="Storm Chaser"
config/description="Follow the vortex. Dodge the debris. Bring the data home."
config/version="0.18.1"
run/main_scene="res://main.tscn"
config/features=PackedStringArray("4.5", "GL Compatibility")

[display]

window/size/viewport_width=1280
window/size/viewport_height=720
window/size/window_width_override=1280
window/size/window_height_override=720
window/stretch/mode="canvas_items"

[editor]

movie_writer/video_quality=0.86

[editor_overrides]

text_editor/behavior/indent/type=0
text_editor/behavior/indent/size=4

[rendering]

textures/vram_compression/import_etc2_astc=true
renderer/rendering_method="gl_compatibility"
renderer/rendering_method.mobile="gl_compatibility"
anti_aliasing/quality/msaa_3d=1
environment/defaults/default_clear_color=Color(0.025, 0.045, 0.055, 1)
